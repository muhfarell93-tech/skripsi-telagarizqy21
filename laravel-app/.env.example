APP_NAME="Telaga Rizqy 21 POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telagarizqy21_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@telagarizqy21.test"
MAIL_FROM_NAME="${APP_NAME}"

# Kredensial Payment Gateway Midtrans
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=G123456789
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXX
MIDTRANS_SERVER_KEY=SB-Mid-server-YYYYYY

# Password demo hanya digunakan pada APP_ENV=local/testing; gunakan nilai unik yang kuat.
SEED_ADMIN_PASSWORD=
SEED_CASHIER_PASSWORD=

