{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/(assets|images|audio|diagrams)/(.*)",
      "dest": "/laravel-app/public/$1/$2"
    },
    {
      "src": "/(build|vendor)/(.*)",
      "dest": "/laravel-app/public/$1/$2"
    },
    {
      "src": "/manifest.json",
      "dest": "/laravel-app/public/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/laravel-app/public/sw.js"
    },
    {
      "src": "/favicon.ico",
      "dest": "/laravel-app/public/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "CACHE_DRIVER": "array",
    "LOG_CHANNEL": "stderr",
    "SESSION_DRIVER": "cookie"
  }
}
